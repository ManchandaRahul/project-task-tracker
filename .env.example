# Create a Neon database at https://console.neon.tech, then copy its pooled connection string here.
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
PORT=3001

# Optional: email delivery for project daily follow-up summaries.
# Without these values, project notifications remain queued and visible in each recipient's User Workspace.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Project Hub <notifications@your-domain.com>

# The server must stay running for enabled project schedules to execute at 09:00 Asia/Kolkata.
